---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../utils/url';
---

<BaseLayout title="페이지를 찾을 수 없습니다">
  <div class="container">
    <div class="notfound">
      <span class="code">404</span>
      <h1>찾으시는 페이지가 없습니다</h1>
      <p class="muted" style="max-width:44ch">
        주소가 바뀌었거나 삭제된 글일 수 있습니다. 검색으로 찾아보거나 글
        목록에서 확인해 보세요.
      </p>
      <div class="chip-row" style="justify-content:center;margin-top:8px">
        <a class="btn btn-primary" href={withBase('')}>
          홈으로
          <Icon name="arrowRight" size={16} />
        </a>
        <button type="button" class="btn" data-open-palette>
          <Icon name="search" size={15} />
          검색하기
        </button>
      </div>
    </div>
  </div>
</BaseLayout>
