---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = Astro.base;
---
<BaseLayout title="404">
  <section class="section">
    <div>
      <h2>페이지를 찾을 수 없습니다.</h2>
      <p>요청하신 페이지가 이동되었거나 삭제되었습니다.</p>
    </div>
    <a class="button" href={base}>홈으로 이동</a>
  </section>
</BaseLayout>
