---
import Icon from './Icon.astro';

type Props = { title: string; url: string };

const { title, url } = Astro.props;

const xHref = `https://x.com/intent/tweet?text=${encodeURIComponent(
  title,
)}&url=${encodeURIComponent(url)}`;
const linkedInHref = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(
  url,
)}`;
---

<div class="share-bar">
  <span class="label">이 글 공유하기</span>

  <button type="button" class="btn" data-copy-link data-url={url}>
    <Icon name="link" size={15} />
    <span data-copy-link-label>링크 복사</span>
  </button>

  <a class="btn" href={xHref} target="_blank" rel="noopener noreferrer">
    <Icon name="x" size={15} />
    X
  </a>

  <a class="btn" href={linkedInHref} target="_blank" rel="noopener noreferrer">
    LinkedIn
  </a>
</div>

<script>
  const setupShare = () => {
    document.querySelectorAll('[data-copy-link]').forEach((button) => {
      if (button.dataset.bound === 'true') return;
      button.dataset.bound = 'true';

      button.addEventListener('click', async () => {
        const url = button.dataset.url || window.location.href;
        const label = button.querySelector('[data-copy-link-label]');

        try {
          await navigator.clipboard.writeText(url);
        } catch {
          return;
        }

        if (label) {
          label.textContent = '복사됨!';
          window.setTimeout(() => {
            label.textContent = '링크 복사';
          }, 1600);
        }
      });
    });
  };

  setupShare();
  document.addEventListener('astro:page-load', setupShare);
</script>
