---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadPosts } from '../../utils/posts';

export function getStaticPaths() {
  const posts = loadPosts();
  const tags = [...new Set(posts.flatMap((post) => post.meta.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.meta.tags.includes(tag)) }
  }));
}

const { tag, posts } = Astro.props;
const base = Astro.base;
---
<BaseLayout title={`태그: ${tag}`}>
  <div class="card">
    <h1>태그: {tag}</h1>
    <ul>
      {posts.map((post) => (
        <li><a href={`${base}posts/${post.slug}`}>{post.meta.title}</a></li>
      ))}
    </ul>
  </div>
</BaseLayout>
