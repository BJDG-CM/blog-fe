---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrivatePost from '../../components/PrivatePost';
import { getPostStats, loadPosts, renderPostHtml } from '../../utils/posts';

export function getStaticPaths() {
  const posts = loadPosts();
  return posts.map((post) => ({
    params: { slug: post.slug }
  }));
}

const posts = loadPosts();
const { slug } = Astro.params;
const post = posts.find((item) => item.slug === slug);
if (!post) {
  throw new Error('Post not found');
}

const privateMode = import.meta.env.PUBLIC_PRIVATE_MODE === 'true';
const html = renderPostHtml(post);
---
<BaseLayout title={post.meta.title}>
  <article class="post-body">
    <a class="back-link" href={`${Astro.base}#posts`}>← Back to posts</a>
    <div class="post-meta">
      <span>{post.meta.tags[0] ?? 'Essay'}</span>
      <span>•</span>
      <span>{post.meta.date}</span>
      <span>•</span>
      <span>{getPostStats(post).readingTime}</span>
    </div>
    <h1>{post.meta.title}</h1>
    <p class="post-summary">{post.meta.summary}</p>
    <div class="tag-list">
      {post.meta.tags.map((tag) => (
        <a class="tag-pill" href={`${Astro.base}tags/${tag}`}>{tag}</a>
      ))}
    </div>
    <div style={{ marginTop: '1.5rem' }}>
      {privateMode && post.encrypted ? (
        <PrivatePost client:load payload={post.encrypted} />
      ) : (
        <div class="post-content" set:html={html} />
      )}
    </div>
  </article>
</BaseLayout>
