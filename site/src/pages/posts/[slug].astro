---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrivatePost from '../../components/PrivatePost';
import { loadPosts, renderPostHtml } from '../../utils/posts';

export function getStaticPaths() {
  return loadPosts().map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const privateMode = import.meta.env.PUBLIC_PRIVATE_MODE === 'true';
const html = renderPostHtml(post);
---
<BaseLayout title={post.meta.title}>
  <article class="card">
    <h1>{post.meta.title}</h1>
    <small>{post.meta.date}</small>
    <div style={{ marginTop: '1rem' }}>
      {privateMode && post.encrypted ? (
        <PrivatePost client:load payload={post.encrypted} />
      ) : (
        <div class="post-content" set:html={html} />
      )}
    </div>
  </article>
</BaseLayout>
