      {
        "type": "codeBlock",
        "attrs": { "language": "typescript" },
        "content": [
          {
            "type": "text",
            "text": "// 태그 자카드 유사도로 관련 글을 고른다\nconst shared = tags.filter((tag) => currentTags.has(tag)).length;\nconst union = new Set([...currentTags, ...tags]).size || 1;\n\nreturn { post, score: shared / union };"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "각 블록에는 복사 버튼이 붙어 있어 마우스 두 번이면 그대로 가져갈 수 있습니다."
          }
        ]
