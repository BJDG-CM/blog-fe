---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadPosts } from '../../utils/posts';
const posts = loadPosts();
const tags = [...new Set(posts.flatMap((post) => post.meta.tags))].sort();
const base = Astro.base;
---
<BaseLayout title="태그">
  <section class="section">
    <div>
      <h2>Tags</h2>
      <p>관심 있는 태그를 선택해 글을 모아보세요.</p>
    </div>
    <div class="filters">
      {tags.map((tag) => (
        <a class="chip" href={`${base}tags/${tag}`}>{tag}</a>
      ))}
    </div>
  </section>
</BaseLayout>
